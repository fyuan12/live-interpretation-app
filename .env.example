# Live Interpreter Environment Variables

# Shared password for authentication
APP_PASSWORD=your-shared-password

# Secret key for JWT signing (generate a random 256-bit string)
JWT_SECRET=your-random-jwt-secret-at-least-32-characters

# Google Cloud Translation API key (console.cloud.google.com → APIs & Services → Credentials)
# Enable "Cloud Translation API" in your GCP project before use.
GOOGLE_TRANSLATE_API_KEY=your-google-translate-api-key

# Deepgram API key (from https://console.deepgram.com/)
DEEPGRAM_API_KEY=your-deepgram-api-key

# DeepL API key — no longer required (kept for reference if reverting)
# DEEPL_API_KEY=your-deepl-api-key
